# Copy to backend/.env and fill in. Never commit the real .env.

# --- Nebius Token Factory (OpenAI-compatible chat completions) ---
# Leave NEBIUS_API_KEY empty to keep the pure-git conflict score.
# Model: NVIDIA Nemotron 3 Super. https://nebius.com/services/token-factory/nemotron
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Set to false to skip the model even when a key is present.
NEBIUS_ENABLED=true
# Seconds for the single chat-completions attempt (no retries).
NEBIUS_TIMEOUT_SECONDS=40
# Top-K: how many prefiltered branch pairs may call the model per request.
NEBIUS_MAX_PAIRS=5
# Listed Nemotron 3 Super price (USD per 1M tokens) for the cost estimate.
NEMOTRON_INPUT_USD_PER_1M=0.30
NEMOTRON_OUTPUT_USD_PER_1M=0.90

# --- Tavily (Resolver doc lookups) ---
TAVILY_API_KEY=

# --- App ---
DEFAULT_BASE_BRANCH=main
WORKSPACE_DIR=.workspace
