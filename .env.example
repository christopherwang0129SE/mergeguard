# Copy to backend/.env and fill in. Never commit the real .env.

# --- Nebius Token Factory (OpenAI-compatible) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=Qwen/Qwen2.5-72B-Instruct

# --- Tavily (Resolver doc lookups) ---
TAVILY_API_KEY=

# --- GitHub pull-request integration ---
GITHUB_REPOSITORY=
GITHUB_TOKEN=
GITHUB_SEATED_USERS=

# --- App ---
DEFAULT_BASE_BRANCH=main
WORKSPACE_DIR=.workspace

# --- Resolver ---
# Set NEBIUS_MODEL to a model available in your Token Factory account.
# Optional test argv, run from the analyzed repository's root (JSON array).
# Execute repository tests only for repositories you trust.
RESOLVER_TEST_COMMAND=[]
RESOLVER_TEST_TIMEOUT=60
RESOLVER_MAX_FILE_BYTES=100000
RESOLVER_MAX_CONFLICTS=20
